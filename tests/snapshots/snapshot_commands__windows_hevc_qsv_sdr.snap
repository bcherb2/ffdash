---
source: tests/snapshot_commands.rs
expression: out
---
ffmpeg -analyzeduration 200M -probesize 200M -init_hw_device qsv=qs -filter_hw_device qs -i /tmp/input.mp4 -progress - -nostats -vf format=nv12,hwupload=extra_hw_frames=64,vpp_qsv=format=nv12 -c:v hevc_qsv -q:v 26 -preset medium -bf 2 -look_ahead 1 -look_ahead_depth 40 -g:v 240 -pix_fmt nv12 -map 0:v:0? -map 0:a:0? -c:a:0 libopus -b:a:0 128k -vbr:a:0 on -map 0:s? -map 0:t? -c:s copy -c:t copy -map_metadata 0 -map_chapters 0 -y /tmp/output.mkv
